prefix                         = "tflab"
subscription_id                = "<subscription-id>"
operator_cidrs                 = ["<your-public-ip>/32"] # curl -s https://ifconfig.me
public_dns_zone_name           = "<your-zone>"           # e.g. example.com
public_dns_zone_resource_group = "<zone-rg>"
# public_dns_zone_subscription_id = "<subscription-id>" # only if the parent zone is in another subscription (defaults to subscription_id)
# create_lab_delegation = false                          # only if the parent zone is in another tenant; add the NS record by hand
hcp_organization               = "<hcp-terraform-org>"
# Connect the Stack to GitHub with exactly one of these two:
github_app_installation_id     = "<ghain-...>"  # GitHub App installation
# vcs_oauth_token_id           = "<ot-...>"     # classic GitHub OAuth connection (org Settings > Version Control > Providers)
github_repo                    = "<owner>/<repo>" # your copy of this repository, which the Stack reads
# github_branch                = "main"           # the branch the Stack tracks (default main)
tfe_license_file               = "~/licences/terraform.hclic"
tfc_agent_version              = "1.33.0" # must be 1.25.2 or later for Stacks
owner_tag                      = "<you>"
expires_tag                    = "<YYYY-MM-DD>"
budget_contact_emails          = ["<you@example.com>"]
